{
  "$schema": "https://opencode.ai/config.json",

  // Keep orchestration shallow. Primary agent may use read-only helpers,
  // but helpers must not recursively create more agents.
  "default_agent": "build",
  "subagent_depth": 1,
  "share": "manual",

  // Task branches may be pushed automatically after tests/build pass.
  // Protect main and history rewriting.
  "permission": {
    // Allow API/dependency inspection from Gradle's shared cache while
    // keeping that external directory read-only for Agent file edits.
    "external_directory": {
      "~/.gradle/caches/**": "allow"
    },
    "edit": {
      "~/.gradle/caches/**": "deny"
    },
    "bash": {
      "git push*": "allow",
      "git push origin main*": "deny",
      "git push * main*": "deny",
      "git push --force*": "deny",
      "git push * --force*": "deny",
      "git push --force-with-lease*": "deny",
      "git push * --force-with-lease*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "rm -rf*": "deny"
    }
  },
  "mcp": {
    "pixellab": {
      "type": "remote",
      "url": "https://api.pixellab.ai/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {file:~/.config/projects/pixellab-token}"
      }
    }
  },

  // Do not let the generic helper become a second implementation agent
  // inside the same worktree.
  "agent": {
    "general": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}
