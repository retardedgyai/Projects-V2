#!/usr/bin/env python3
"""Minimal ProjectS issue/worktree/OpenCode conductor."""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


DEFAULT_MODEL = "openai/gpt-5.6-luna"
BRANCH_PATTERN = re.compile(
    r"(?im)^\s*(?:[-*]\s*)?(?:suggested\s+)?branch\s*:\s*`?([A-Za-z0-9][A-Za-z0-9._/-]*)`?"
)


class ConductorError(RuntimeError):
    pass


def now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def run(command: list[str], cwd: Path, *, check: bool = True) -> str:
    result = subprocess.run(command, cwd=cwd, text=True, capture_output=True)
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "command failed"
        raise ConductorError(f"{' '.join(command)}: {detail}")
    return result.stdout


def repo_root() -> Path:
    override = os.environ.get("PROJECTS_CONDUCTOR_ROOT")
    if override:
        return Path(override).expanduser().resolve()
    return Path(run(["git", "rev-parse", "--show-toplevel"], Path.cwd()).strip()).resolve()


def state_path(root: Path) -> Path:
    override = os.environ.get("PROJECTS_CONDUCTOR_STATE_FILE")
    if override:
        return Path(override).expanduser().resolve()
    return root / ".projects" / "conductor-state.json"


def worktree_path(root: Path, issue: int) -> Path:
    configured_root = os.environ.get("PROJECTS_CONDUCTOR_WORKTREE_ROOT")
    if configured_root:
        return Path(configured_root).expanduser().resolve() / f"issue-{issue}"
    return root.parent / f"{root.name}-issue-{issue}"


def empty_state() -> dict[str, Any]:
    return {"version": 1, "updatedAt": now(), "tasks": []}


def load_state(path: Path) -> dict[str, Any]:
    if not path.exists():
        return empty_state()
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ConductorError(f"state file is unreadable: {path}: {error}") from error
    if not isinstance(state, dict) or not isinstance(state.get("tasks", []), list):
        raise ConductorError(f"state file has an invalid shape: {path}")
    return state


def save_state(path: Path, state: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    state["version"] = 1
    state["updatedAt"] = now()
    temporary = path.with_name(f".{path.name}.tmp")
    temporary.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(temporary, path)


def repository_name(root: Path) -> str:
    configured = os.environ.get("PROJECTS_CONDUCTOR_REPO")
    if configured:
        return configured
    remote = run(["git", "remote", "get-url", "origin"], root).strip()
    match = re.search(r"github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?$", remote)
    if not match:
        raise ConductorError(f"cannot resolve GitHub repository from origin: {remote}")
    return f"{match.group(1)}/{match.group(2)}"


def issue_payload(root: Path, issue: int) -> dict[str, Any]:
    result = subprocess.run(
        [
            "gh",
            "issue",
            "view",
            str(issue),
            "--repo",
            repository_name(root),
            "--json",
            "number,title,body,comments",
        ],
        cwd=root,
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "gh issue view failed"
        raise ConductorError(f"Issue #{issue}: {detail}")
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise ConductorError(f"Issue #{issue}: gh returned invalid JSON: {error}") from error
    if not isinstance(payload, dict):
        raise ConductorError(f"Issue #{issue}: gh returned an invalid payload")
    return payload


def comment_text(comment: Any) -> str:
    if isinstance(comment, dict):
        return str(comment.get("body", ""))
    return str(comment)


def resolve_branch(issue: int, payload: dict[str, Any]) -> str:
    texts = [str(payload.get("body", ""))]
    comments = payload.get("comments", [])
    if isinstance(comments, list):
        texts.extend(comment_text(comment) for comment in comments)
    for text in reversed(texts):
        match = BRANCH_PATTERN.search(text)
        if match:
            return match.group(1)
    return f"issue/{issue}"


def parse_worktrees(root: Path) -> list[dict[str, str]]:
    output = run(["git", "worktree", "list", "--porcelain"], root)
    records: list[dict[str, str]] = []
    current: dict[str, str] = {}
    for line in output.splitlines() + [""]:
        if line.startswith("worktree "):
            if current:
                records.append(current)
            current = {"path": line.removeprefix("worktree ")}
        elif line.startswith("branch "):
            current["branch"] = line.removeprefix("branch ").removeprefix("refs/heads/")
        elif not line and current:
            records.append(current)
            current = {}
    return records


def ref_exists(root: Path, ref: str) -> bool:
    return subprocess.run(
        ["git", "rev-parse", "--verify", ref], cwd=root, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    ).returncode == 0


def ensure_clean_worktree(path: Path) -> None:
    if run(["git", "status", "--short"], path).strip():
        raise ConductorError(f"worktree is dirty and cannot be reused: {path}")


def ensure_worktree(root: Path, issue: int, branch: str) -> Path:
    records = parse_worktrees(root)
    for record in records:
        if record.get("branch") == branch:
            path = Path(record["path"]).resolve()
            ensure_clean_worktree(path)
            current_branch = run(["git", "branch", "--show-current"], path).strip()
            if current_branch != branch:
                raise ConductorError(f"worktree branch mismatch at {path}: {current_branch} != {branch}")
            return path

    path = worktree_path(root, issue)
    if path.exists():
        raise ConductorError(f"worktree target already exists but is not attached to {branch}: {path}")

    local_ref = f"refs/heads/{branch}"
    remote_ref = f"refs/remotes/origin/{branch}"
    if ref_exists(root, local_ref):
        run(["git", "worktree", "add", str(path), branch], root)
    elif ref_exists(root, remote_ref):
        run(["git", "worktree", "add", "--track", "-b", branch, str(path), f"origin/{branch}"], root)
    else:
        base = os.environ.get("PROJECTS_CONDUCTOR_BASE", "origin/main")
        if not ref_exists(root, base):
            raise ConductorError(f"cannot create {branch}: base ref does not exist: {base}")
        run(["git", "worktree", "add", "-b", branch, str(path), base], root)

    ensure_clean_worktree(path)
    current_branch = run(["git", "branch", "--show-current"], path).strip()
    if current_branch != branch:
        raise ConductorError(f"new worktree branch mismatch at {path}: {current_branch} != {branch}")
    return path


def process_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return False
    try:
        stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
        state = stat.rsplit(")", 1)[1].strip().split(" ", 1)[0]
        if state == "Z":
            return False
    except OSError:
        pass
    return True


def process_command(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
    except OSError:
        return ""


def process_matches(task: dict[str, Any]) -> bool:
    pid = task.get("pid")
    worktree = task.get("worktree")
    if not isinstance(pid, int) or not isinstance(worktree, str) or not process_alive(pid):
        return False
    command = process_command(pid)
    return "opencode" in command.lower() and str(Path(worktree).resolve()) in command


def refresh_tasks(state: dict[str, Any]) -> bool:
    changed = False
    for task in state.get("tasks", []):
        if task.get("state") != "RUNNING":
            continue
        if not process_alive(task.get("pid", -1)):
            task["state"] = "EXITED"
            changed = True
        elif not process_matches(task):
            task["state"] = "UNKNOWN"
            changed = True
    return changed


def task_for_issue(state: dict[str, Any], issue: int) -> dict[str, Any] | None:
    return next((task for task in state.get("tasks", []) if task.get("issue") == issue), None)


def start(root: Path, issues: list[int], parallel: int) -> None:
    if parallel < 1:
        raise ConductorError("--parallel must be at least 1")
    if len(issues) > parallel:
        raise ConductorError(f"v0.1 accepts at most {parallel} issues per start")
    if len(set(issues)) != len(issues):
        raise ConductorError("duplicate Issue numbers are not allowed")

    state_file = state_path(root)
    state = load_state(state_file)
    refresh_tasks(state)
    for issue in issues:
        existing = task_for_issue(state, issue)
        if existing and existing.get("state") in {"RUNNING", "UNKNOWN"}:
            raise ConductorError(f"Issue #{issue} is already tracked as {existing['state']}")

    prepared: list[tuple[int, str, Path, dict[str, Any]]] = []
    branches: set[str] = set()
    for issue in issues:
        payload = issue_payload(root, issue)
        branch = resolve_branch(issue, payload)
        if branch in branches:
            raise ConductorError(f"multiple Issues resolve to the same branch: {branch}")
        branches.add(branch)
        for task in state.get("tasks", []):
            if task.get("branch") == branch and task.get("state") in {"RUNNING", "UNKNOWN"}:
                raise ConductorError(f"branch {branch} is already tracked by Issue #{task.get('issue')}")
        path = ensure_worktree(root, issue, branch)
        prepared.append((issue, branch, path, payload))

    logs_dir = state_file.parent / "logs"
    logs_dir.mkdir(parents=True, exist_ok=True)
    environment = os.environ.copy()
    environment["PROJECTS_V2_SUPPRESS_MANUAL_SMOKE"] = "1"
    model = os.environ.get("PROJECTS_CONDUCTOR_MODEL", DEFAULT_MODEL)
    old_tasks = [task for task in state.get("tasks", []) if task.get("issue") not in issues]
    started: list[dict[str, Any]] = []
    try:
        for issue, branch, path, payload in prepared:
            log_file = logs_dir / f"issue-{issue}.log"
            output = log_file.open("ab")
            try:
                process = subprocess.Popen(
                    [
                        "opencode",
                        "run",
                        "--auto",
                        "--dir",
                        str(path),
                        "--model",
                        model,
                        "--command",
                        "issue",
                        str(issue),
                    ],
                    cwd=root,
                    env=environment,
                    stdin=subprocess.DEVNULL,
                    stdout=output,
                    stderr=subprocess.STDOUT,
                    start_new_session=True,
                )
            finally:
                output.close()
            started.append(
                {
                    "issue": issue,
                    "title": payload.get("title", ""),
                    "branch": branch,
                    "worktree": str(path),
                    "state": "RUNNING",
                    "pid": process.pid,
                    "session": str(process.pid),
                    "model": model,
                    "startedAt": now(),
                    "log": str(log_file),
                }
            )
    except OSError as error:
        state["tasks"] = old_tasks + started
        save_state(state_file, state)
        raise ConductorError(f"failed to start OpenCode: {error}") from error

    state["tasks"] = old_tasks + started
    save_state(state_file, state)
    for task in started:
        print(f"Started #{task['issue']} {task['branch']} PID {task['pid']} worktree {task['worktree']}")


def status(root: Path) -> None:
    state_file = state_path(root)
    state = load_state(state_file)
    changed = refresh_tasks(state)
    if changed:
        save_state(state_file, state)
    tasks = state.get("tasks", [])
    if not tasks:
        print("No conductor tasks.")
        return
    print(f"{'ISSUE':<7} {'BRANCH':<32} {'STATE':<9} PID/SESSION")
    for task in tasks:
        issue = f"#{task.get('issue', '?')}"
        branch = str(task.get("branch", ""))
        state_name = str(task.get("state", "UNKNOWN"))
        pid = task.get("pid", "-")
        print(f"{issue:<7} {branch:<32} {state_name:<9} {pid}/{task.get('session', pid)}")


def stop(root: Path, issues: list[int]) -> None:
    state_file = state_path(root)
    state = load_state(state_file)
    errors: list[str] = []
    for issue in issues:
        task = task_for_issue(state, issue)
        if task is None:
            errors.append(f"Issue #{issue} is not tracked")
            continue
        pid = task.get("pid")
        if not isinstance(pid, int) or not process_alive(pid):
            task["state"] = "EXITED"
            print(f"Issue #{issue} is already exited")
            continue
        if not process_matches(task):
            task["state"] = "UNKNOWN"
            errors.append(f"Issue #{issue}: PID {pid} did not match its recorded OpenCode/worktree")
            continue
        try:
            os.killpg(pid, signal.SIGTERM)
        except ProcessLookupError:
            task["state"] = "EXITED"
            continue
        deadline = time.monotonic() + 2.0
        while process_alive(pid) and time.monotonic() < deadline:
            time.sleep(0.1)
        task["state"] = "EXITED" if not process_alive(pid) else "UNKNOWN"
        if task["state"] == "EXITED":
            print(f"Stopped Issue #{issue} PID {pid}")
        else:
            errors.append(f"Issue #{issue}: PID {pid} did not exit after SIGTERM")
    save_state(state_file, state)
    if errors:
        raise ConductorError("; ".join(errors))


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="projects-conductor")
    commands = root.add_subparsers(dest="command", required=True)

    start_parser = commands.add_parser("start", help="create/reuse worktrees and start OpenCode workers")
    start_parser.add_argument("issues", nargs="+", type=int)
    start_parser.add_argument("--parallel", type=int, default=4)

    status_parser = commands.add_parser("status", help="show tracked worker state")
    status_parser.set_defaults()

    stop_parser = commands.add_parser("stop", help="stop only the selected OpenCode workers")
    stop_parser.add_argument("issues", nargs="+", type=int)
    return root


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        root = repo_root()
        if args.command == "start":
            start(root, args.issues, args.parallel)
        elif args.command == "status":
            status(root)
        elif args.command == "stop":
            stop(root, args.issues)
        else:
            raise ConductorError(f"unknown command: {args.command}")
    except ConductorError as error:
        print(f"projects-conductor: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
